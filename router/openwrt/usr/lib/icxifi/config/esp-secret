#!/bin/sh
set -eu
export PATH="/usr/sbin:/usr/bin:/sbin:/bin"

device_id="${1:-}"
secret="${2:-}"

safe_token() {
  case "$1" in ''|*[!A-Za-z0-9._:-]*) return 1 ;; *) return 0 ;; esac
}

new_secret() {
  dd if=/dev/urandom bs=32 count=1 2>/dev/null | hexdump -ve '1/1 "%02x"'
}

mkdir -p /etc/icxifi/esp_secrets

if [ -z "$device_id" ]; then
  path="/etc/icxifi/esp_secret"
else
  safe_token "$device_id" || {
    echo "Invalid device id" >&2
    exit 2
  }
  path="/etc/icxifi/esp_secrets/$device_id"
fi

[ -n "$secret" ] || secret="$(new_secret)"

case "$secret" in ''|*[!A-Fa-f0-9]*) echo "Secret must be hex" >&2; exit 2 ;; esac

printf '%s\n' "$secret" > "$path"
chmod 600 "$path"
chown root:root "$path" 2>/dev/null || true

echo "$path"
echo "$secret"
