#!/bin/sh

set -eu
export PATH="/usr/sbin:/usr/bin:/sbin:/bin"

TARGET_FILE="/tmp/icxifi_coin_target"

print_json() {
  printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n%s\n' "$1"
}

urldecode() {
  value="${1//+/ }"
  printf '%b' "${value//%/\\x}"
}

safe_ip() {
  case "$1" in ''|*[!0-9.]*) return 1 ;; *.*.*.*) return 0 ;; *) return 1 ;; esac
}

safe_mac() {
  case "$1" in ''|*[!A-Fa-f0-9:-]*) return 1 ;; *) return 0 ;; esac
}

json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

resolve_mac_from_ip() {
  ip="$1"
  ip neigh show "$ip" 2>/dev/null | awk '{print $5; exit}'
}

clientIp=""
clientMac=""

IFS='&'
for pair in ${QUERY_STRING:-}; do
  key="${pair%%=*}"
  val="${pair#*=}"
  [ "$key" = "$pair" ] && val=""
  val="$(urldecode "$val")"
  case "$key" in
    clientIp|clientip|ip) clientIp="$val" ;;
    clientMac|clientmac|mac) clientMac="$val" ;;
  esac
done
unset IFS

remoteIp="${REMOTE_ADDR:-}"
if [ -z "$clientIp" ] || [ "$clientIp" = "unknown" ]; then
  clientIp="$remoteIp"
fi

if ! safe_ip "$clientIp"; then
  print_json '{"ok":false,"error":"Invalid client IP"}'
  exit 0
fi

if [ -n "$clientMac" ] && [ "$clientMac" != "unknown" ] && ! safe_mac "$clientMac"; then
  clientMac=""
fi

if [ -z "$clientMac" ]; then
  clientMac="$(resolve_mac_from_ip "$clientIp" || true)"
fi

now="$(date +%s)"
tmp="${TARGET_FILE}.$$"
printf '%s|%s|%s\n' "$now" "$clientIp" "$clientMac" > "$tmp"
mv -f "$tmp" "$TARGET_FILE"

print_json "$(printf '{"ok":true,"clientIp":"%s","clientMac":"%s","expiresInSeconds":180}' \
  "$(json_escape "$clientIp")" "$(json_escape "$clientMac")")"
